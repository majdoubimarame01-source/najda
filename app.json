{
  "expo": {
    "name": "najda",
    "slug": "najda",
    "version": "1.0.0",
    "scheme": "najda",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tn.najda.app"
    },
    "android": {
      "package": "tn.najda.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#000000",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E11D22",
          "defaultChannel": "alerts"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "najda uses your location only to send it to your trusted circle during an alert."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "21577bb1-f621-4d9a-8fb6-788ca7c3adac"
      }
    },
    "owner": "marame01"
  }
}
