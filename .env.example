# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (they are not secrets:
# the Supabase anon key is designed to be public; the ORS key is a free rate-limited key).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: OpenRouteService free key (walking routes). Without it: straight line + running speed.
EXPO_PUBLIC_ORS_KEY=
# Printed by `npx eas-cli@latest init` (needed for Expo push tokens).
EAS_PROJECT_ID=
